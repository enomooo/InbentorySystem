@page "/shohin/delete/confirm/{Shohincode}"
@using InbentorySystem.Data
@using InbentorySystem.Data.Models
@using InbentorySystem.Infrastructure.Interfaces
@using InbentorySystem.Services.Interfaces
@inject IShohinRepository ShohinRepo
@inject IShohinService ShohinService
@inject NavigationManager NavManager

<PageTitle>商品削除確認: @ShohinCode</PageTitle>

<h1>商品削除確認</h1>

<button class="btn btn-secondary mb-3" @onclick="GoBack">
	<span class="oi oi-arrow-left"></span>選択画面へ戻る
</button>

@if (IsLoading)
{
	<p><em>データを読み込み中です...</em></p>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
	<div class="alert alert-danger">@ErrorMessage</div>
}
else if (Model == null)
{
	<div class="alert alert-warning">指定された商品コード(@ShohinCode)は見つかりませんでした</div>
}
else
{
	<div class="card p-4 mb-4">
		<h2>削除画面</h2>
		<table class="table table-bordered table-striped">
			<thead>
				<tr>
					<th>商品コード</th>
					<th>商品名（漢字）</th>
					<th>商品名（かな）</th>
					<th class="text-end">仕入値</th>
					<th class="text-end">売値</th>
					<th>仕入先コード</th>
				</tr>
			</thead>
			<tbody>

				<tr>
					<td>@Model.ShohinCode</td>
					<td>@Model.ShohinMeiKanji</td>
					<td>@Model.ShohinMeiKana</td>
					<td class="text-end">@Model.Shiirene.ToString("N0")</td>
					<td class="text-end">@Model.Urine.ToString("N0")</td>
					<td>@Model.ShiiresakiCode</td>
				</tr>

			</tbody>
		</table>
	<div class="alert alert-danger">
		<h2>削除ボタンを押すと元に戻りませんが</h2>
			<h2>本当に削除しますがよろしいですか？</h2>
			<h2>キャンセルは商品管理メニューに戻るを押してください</h2>
	</div>

	

		<button class="btn btn-danger mt-3" @onclick="DeleteConfirmedAsync">
			<span class="oi oi-trash">削除</span> 
		</button>

		@if (!string.IsNullOrEmpty(DeleteErrorMessage))
		{
			<div class="alert alert-danger mt-3">@DeleteErrorMessage</div>
		}
	</div>
	<button class="btn btn-secondary w-100 mb-3" @onclick="GoBack">
		<span class="pointer-event oi-arrow-left"></span>商品管理メニューへ戻る
	</button>
}

@code {
	[Parameter]
	// URLから渡される商品データ（修正対象の識別子）
	public string ShohinCode { get; set; } = string.Empty;

	private ShohinModel? Model { get; set; }
	private bool IsLoading = true;
	private string ErrorMessage = string.Empty;
	private string DeleteErrorMessage = string.Empty;

	/// <summary>
	/// ページ初期化時にServiceから削除対象の商品情報を取得
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		IsLoading = true;

		Model = ShohinService.GetLastDeletedShohin();

		if (Model == null)
		{
			ErrorMessage = $"指定された商品コード('{ShohinCode}')の情報がサービスに見つかりませんでした。";
		}

		IsLoading = false;
	}

	/// <summary>
	/// 商品削除を実行して成功すればShohinDeleteResultへ遷移
	/// </summary>
	private async Task DeleteConfirmedAsync()
	{
		if (Model == null) return;

		DeleteErrorMessage = string.Empty;
		try
		{
			// ShohinRepositoryのDeleteAsyncを呼び出してDBからデータを削除
			await ShohinRepo.DeleteAsync(Model.ShohinCode);

			ShohinService.SetLastDeletedShohin(Model);

			NavManager.NavigateTo($"/shohin/delete/result?Shohincode={Model.ShohinCode}");
		}
		catch (Exception ex)
		{
			DeleteErrorMessage = $"削除中にシステムエラーが発生しました：{ex.Message}";
		}
	}

	/// <summary>
	/// 商品管理メニューに戻る
	/// </summary>
	private void GoBack()
	{
		NavManager.NavigateTo("/shohin/menu");
	}
}