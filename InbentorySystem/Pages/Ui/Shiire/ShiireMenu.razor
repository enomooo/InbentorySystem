@page "/shiire/menu"
@using InbentorySystem.Data.Models
@using InbentorySystem.Infrastructure.Interfaces
@using InbentorySystem.Services.Interfaces
@inject IShiireRepository ShiireRepository
@inject IShiireService ShiireService
@inject NavigationManager NavManager

<PageTitle>仕入管理メニュー</PageTitle>

<h1>仕入管理メニュー</h1>

@* 検索・修正・削除共通のエラーメッセージ表示エリア*@
@if (!string.IsNullOrEmpty(Message))
{
	<div class="@(IsError ? "alert alert-danger" : "alert alert-info")" role="alert">@Message</div>
}

@* 仕入検索エリア*@
<div class="card p-4 mb-4">
	<h2>仕入検索</h2>
	<div class="row mb-3">
		<div class="col-md-3">
			<label for="yearMonth" class="form-label">仕入年月 (YYYY-MM)</label>
			<input id="yearMonth" type="month" class="form-control" @bind="SearchYearMonth" />
		</div>
		<div class="col-md-3">
			<label for="codeKeywordSearch" class="form-label">商品コード</label>
			<input id="codeKeywordSearch" type="text" class="form-control" @bind="SearchShohinCode" placeholder="商品コードの一部を入力" />
		</div>
	</div>
	<div class="d-flex gap-2 mt-4">
		<button type="button" class="btn btn-primary" @onclick='() => SearchAndNavigate("Search")'>
			<i class="bi bi-search"></i> 検索
		</button>
		<button type="button" class="btn btn-secondary" @onclick="ResetSearchForm">リセット</button>
	</div>
</div>

@* 新規仕入登録エリア*@
<div class="card p-4">
	<h2>新規仕入登録</h2>
	<EditForm Model="@NewShiireModel" OnValidSubmit="NewShiireRegistrationAsync">
		<DataAnnotationsValidator />
		<div class="card p-4">
			<div class="row mb-3">
				<label for="ShiireNengappi" class="col-sm-3 col-form-label">仕入日付</label>
				<div class="col-sm-5">
					<InputDate id="ShiireNengappi" @bind-Value="NewShiireModel.ShiireNengappi" class="form-control" />
					<ValidationMessage For="@(() => NewShiireModel.ShiireNengappi)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="ShohinCode" class="col-sm-3 col-form-label">商品コード</label>
				<div class="col-sm-5">
					<InputText id="ShohinCode" @bind-Value="NewShiireModel.ShohinCode" class="form-control" />
					<ValidationMessage For="@(() => NewShiireModel.ShohinCode)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="ShiiresakiCode" class="col-sm-3 col-form-label">仕入先コード</label>
				<div class="col-sm-5">
					<InputText id="ShiiresakiCode" @bind-Value="NewShiireModel.ShiiresakiCode" class="form-control" />
					<ValidationMessage For="@(() => NewShiireModel.ShiiresakiCode)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="Quantity" class="col-sm-3 col-form-label">数量</label>
				<div class="col-sm-3">
					<InputNumber id="Quantity" @bind-Value="NewShiireModel.Quantity" class="form-control" />
					<ValidationMessage For="@(() => NewShiireModel.Quantity)" />
				</div>
			</div>

			<div class="card p-4">
				<div class="d-flex gap-3 mt-4">
					@* type="submit"でRegisterAsyncが呼ばれる*@
					<button type="submit" class="btn btn-success">登録画面</button>
					<button type="button" class="btn btn-secondary" @onclick="ResetNewForm">リセット</button>
				</div>
				@if (!string.IsNullOrEmpty(RegisterErrorMessage))
				{
					<div class="alert alert-danger mt-3">@RegisterErrorMessage</div>
				}
			</div>
		</div>
	</EditForm>
</div>
<hr class="mt-4" />


@if (!string.IsNullOrEmpty(RegisterErrorMessage))
{
	<div class="alert alert-danger mt-3">@RegisterErrorMessage</div>
}

<div class="card p-4 mb-4">
	<h2>仕入修正</h2>
	<div class="card p-4 mb-4">
		<div class="row mb-3">
			<div class="col-md-3">
				<label for="editDate" class="form-label">仕入日付 (YYYY-MM-DD)</label>
				<input id="editDate" type="date" class="form-control" @bind="EditShiireDate" />
			</div>
			<div class="col-md-3">
				<label for="editShohinCode" class="form-label">商品コード</label>
				<input id="editShohinCode" type="text" class="form-control" @bind="EditShohinCode" />
			</div>
		</div>
		<div class="d-flex gap-2">
			<button type="button" class="btn btn-warning" @onclick='() => SearchForEdit(EditShiireDate, EditShohinCode)'>修正画面へ</button>
			<button type="button" class="btn btn-secondary" @onclick="ResetSearchForm">リセット</button>
		</div>
	</div>
</div>

<div class="card p-4 mb-4">
	<h2>仕入削除</h2>
	<div class="card p-4 mb-4">
		<div class="row mb-3">
			<div class="col-md-3">
				<label for="deleteDate" class="form-label">仕入日付 (YYYY-MM-DD)</label>
				<input id="deleteDate" type="date" class="form-control" @bind="DeleteShiireDate" />
			</div>
			<div class="col-md-3">
				<label for="deleteShohinCode" class="form-label">商品コード</label>
				<input id="deleteShohinCode" type="text" class="form-control" @bind="DeleteShiireDate" />
			</div>
		</div>
		<div class="d-flex gap-2">
			<button type="button" class="btn btn-warning" @onclick='() => SearchForDelete(DeleteShiireDate, DeleteShohinCode)'>修正画面へ</button>
			<button type="button" class="btn btn-secondary" @onclick="ResetSearchForm">リセット</button>
		</div>
	</div>
</div>

<button class="btn btn-secondary w-100" @onclick="GoBack">ホームメニューに戻る</button>

@code {
	// メッセージ
	private string? Message { get; set; }
	private bool IsError { get; set; }

	// 検索用
	private DateTime? SearchYearMonth { get; set; }
	private string SearchShohinCode { get; set; } = string.Empty;

	// 登録用
	private ShiireModel NewShiireModel { get; set; } = new();
	private string? RegisterErrorMessage { get; set; }

	// 修正用
	private DateTime? EditShiireDate { get; set; }
	private string EditShohinCode { get; set; } = string.Empty;

	// 修正用
	private DateTime? DeleteShiireDate { get; set; }
	private string DeleteShohinCode { get; set; } = string.Empty;

	/// <summary>
	/// 検索処理
	/// </summary>
	/// <param name="actionType"></param>
	/// <returns></returns>
	private async Task SearchAndNavigate(string actionType)
	{
		Message = null;
		IsError = false;

		try
		{
			if (SearchYearMonth == null || string.IsNullOrWhiteSpace(SearchShohinCode))
			{
				Message = "入力項目が不足しています";
				IsError = true;
				return;
			}

			var year = SearchYearMonth.Value.Year;
			var month = SearchYearMonth.Value.Month;

			// 月単位検索（IShiireRepository 側の月検索メソッドを使用）
			var results = await ShiireRepository.SearchByMonthAsync(year, month, SearchShohinCode);

			if (results == null || results.Count == 0)
			{
				Message = "該当する仕入はありませんでした";
				return;
			}

			ShiireService.SetSearchResults(results);
			NavManager.NavigateTo("/shiire/search");
		}
		catch (Exception ex)
		{
			Message = $"エラーが発生しました: {ex.Message}";
		}
	}

	/// <summary>
	/// 検索フォーム
	/// </summary>
	private void ResetSearchForm()
	{
		SearchYearMonth = null;
		SearchShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// 新規仕入登録
	/// </summary>
	/// <returns></returns>
	private async Task NewShiireRegistrationAsync()
	{
		RegisterErrorMessage = null;

		try
		{
			if (NewShiireModel.ShiireNengappi == default)
			{
				RegisterErrorMessage = "仕入日付を入力してください。";
				return;
			}
			if (string.IsNullOrWhiteSpace(NewShiireModel.ShohinCode))
			{
				RegisterErrorMessage = "商品コードを入力してください。";
				return;
			}
			if (string.IsNullOrWhiteSpace(NewShiireModel.ShiiresakiCode))
			{
				RegisterErrorMessage = "仕入先コードを入力してください。";
				return;
			}
			if (NewShiireModel.Quantity <= 0)
			{
				RegisterErrorMessage = "数量は1以上を入力してください。";
				return;
			}

			var affectedRows = await ShiireRepository.RegisterAsync(NewShiireModel);

			if (affectedRows > 0)
			{
				ShiireService.SetLastRegisteredShiire(NewShiireModel);
				NavManager.NavigateTo("/shiire/register");
				ResetNewForm();
			}
			else
			{
				RegisterErrorMessage = "登録処理が正常に完了しませんでした。影響を受けた行数が0です";
			}
		}
		catch (Exception ex)
		{
			RegisterErrorMessage = $"登録中にシステムエラーが発生しました: {ex.Message}";
		}
	}

	/// <summary>
	/// 登録フォームリセットメソッド
	/// </summary>
	private void ResetNewForm()
	{
		NewShiireModel = new ShiireModel();
		RegisterErrorMessage = null;
	}

	/// <summary>
	/// 仕入修正検索
	/// </summary>
	/// <param name="date">入力された仕入日付</param>
	/// <param name="shohinCode">入力された商品コード</param>
	/// <returns></returns>
	private async Task SearchForEdit(DateTime? date, string shohinCode)
	{
		if (date == null || string.IsNullOrWhiteSpace(shohinCode))
		{
			Message = "入力項目が不足しています";
			IsError = true;
			return;
		}

		var results = await ShiireRepository.SearchByDateAsync(date.Value, shohinCode);

		if (results == null || results.Count == 0)
		{
			Message = "該当する仕入はありませんでした";
			return;
		}

		ShiireService.SetLastEditResult(NewShiireModel);
		NavManager.NavigateTo("/shiire/edit/select");
		ResetEditForm();
	}

	/// <summary>
	/// 修正フォームリセット
	/// </summary>
	private void ResetEditForm()
	{
		EditShiireDate = null;
		EditShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// 仕入れ削除機能
	/// </summary>
	/// <param name="date">入力された仕入日付</param>
	/// <param name="shohinCode">商品コード</param>
	/// <returns></returns>
	private async Task SearchForDelete(DateTime? date, string shohinCode)
	{
		if (date == null || string.IsNullOrWhiteSpace(shohinCode))
		{
			Message = "入力項目が不足しています";
			IsError = true;
			return;
		}

		var results = await ShiireRepository.SearchByDateAsync(date.Value, shohinCode);

		if (results == null || results.Count == 0)
		{
			Message = "該当する仕入はありませんでした";
			return;
		}

		ShiireService.SetLastDeleteResult(NewShiireModel);
		NavManager.NavigateTo("/shiire/delete/select");
		ResetDeleteForm();
	}

	/// <summary>
	/// 削除フォームリセット
	/// </summary>
	private void ResetDeleteForm()
	{
		DeleteShiireDate = null;
		DeleteShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// メインメニューに戻る
	/// </summary>
	private void GoBack()
	{
		NavManager.NavigateTo("/");
	}
}

