@page "/shiire/menu"
@using InbentorySystem.Data.Models
@using InbentorySystem.Infrastructure.Interfaces
@using InbentorySystem.Infrastructure.Models
@using InbentorySystem.Services.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IShiireRepository ShiireRepository
@inject IShohinRepository ShohinRepo
@inject IShiireService ShiireService
@inject IShiiresakiRepository ShiiresakiRepo
@inject NavigationManager NavManager

<PageTitle>仕入管理メニュー</PageTitle>

<h1>仕入管理メニュー</h1>

@* 検索・修正・削除共通のエラーメッセージ表示エリア*@
@if (!string.IsNullOrEmpty(Message))
{
	<div class="@(IsError ? "alert alert-danger" : "alert alert-info")" role="alert">@Message</div>
}

@* 仕入検索エリア*@
<div class="card p-4 mb-4">
	<h2>仕入検索</h2>
	<h5>検索する仕入の年月と商品名を入力してください。</h5>
	<div class="row">
		<div class="col-12 md-3">
			<label for="yearMonth" class="form-label">仕入年月</label>
			<input id="yearMonth" type="text" class="form-control"
				   @bind="SearchYearMonthString" />
		</div>
		<div class="col-12 md-3">
			<label for="codeKeywordSearch" class="form-label">商品コード</label>
			<select id="codeKeywordSearch" class="form-select" @bind="SearchShohinCode">
				@if (ShohinMasterList == null || !ShohinMasterList.Any())
				{
					<option value="">商品マスタ読み込み中...</option>
				}
				else
				{

					<option value=""></option>
					@foreach (var shohin in ShohinMasterList)
					{
						<option value="@shohin.ShohinCode">
							@shohin.ShohinCode : @shohin.ShohinMeiKanji
						</option>
					}
				}
			</select>
		</div>
	</div>
	<div class="d-flex gap-2 mt-4">
		<button type="button" class="btn btn-primary" @onclick='() => SearchAndNavigate("Search")'>
			<i class="bi bi-search">仕入検索</i>
		</button>
		<button type="button" class="btn btn-secondary" @onclick="ResetSearchForm">リセット</button>
	</div>
</div>

@* 新規仕入登録エリア*@
<div class="card p-4">
	<h2>新規仕入登録</h2>
	<EditForm Model="@NewShiireModel" OnValidSubmit="NewShiireRegistrationAsync">
		<DataAnnotationsValidator />
		<div class="card p-4">
			<div class="row mb-3">
				<label for="ShiireBi" class="col-sm-3 col-form-label">仕入日付(YYYY-MM-DD)</label>
				<div class="col-sm-5">
					<input id="ShiireBi" type="text" class="form-control"
						   @bind="NewShiireModel.ShiireBi"
						   @bind:event="oninput" />
					<ValidationMessage For="@(() => NewShiireModel.ShiireBi)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="ShohinCode" class="col-sm-3 col-form-label">商品コード</label>
				<div class="col-sm-5">
					<InputSelect id="ShohinCode" @bind-Value="NewShiireModel.ShohinCode" class="form-control">
						<option value=""></option>
						@foreach (var shohin in ShohinMasterList!)
						{
							<option value="@shohin.ShohinCode">@shohin.ShohinCode : @shohin.ShohinMeiKanji</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => NewShiireModel.ShohinCode)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="ShiiresakiCode" class="col-sm-3 col-form-label">仕入先コード</label>
				<div class="col-sm-5">
					<InputSelect id="ShiiresakiCode" @bind-Value="NewShiireModel.ShiiresakiCode" class="form-control">
						<option value=""></option>
						@foreach (var shiiresaki in ShiiresakiMasterList)
						{
							<option value="@shiiresaki.ShiiresakiCode">@shiiresaki.ShiiresakiCode : @shiiresaki.ShiiresakiMeiKanji</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => NewShiireModel.ShiiresakiCode)" />
				</div>
			</div>
			<div class="row mb-3">
				<label for="Quantity" class="col-sm-3 col-form-label">数量</label>
				<div class="col-sm-3">
					<InputNumber id="Quantity" @bind-Value="NewShiireModel.Quantity" class="form-control" />
					<ValidationMessage For="@(() => NewShiireModel.Quantity)" />
				</div>
			</div>

			<div class="card p-4">
				<div class="d-flex gap-3 mt-4">
					@* type="submit"でRegisterAsyncが呼ばれる*@
					<button type="submit" class="btn btn-success">登録画面</button>
					<button type="button" class="btn btn-secondary" @onclick="ResetNewForm">リセット</button>
				</div>
				@if (!string.IsNullOrEmpty(RegisterErrorMessage))
				{
					<div class="alert alert-danger mt-3">@RegisterErrorMessage</div>
				}
			</div>
		</div>
	</EditForm>
</div>
<hr class="mt-4" />

<div class="card p-4 mb-4">
	<h2>仕入修正</h2>

	<div class="row mb-3">
		<label for="editDate" class="col-sm-3 col-form-label">仕入日付(YYYY-MM-DD)</label>
		<div class="col-sm-5">
			<input id="editDate" type="text" class="form-control"
				   @bind="EditShiireDate" />
		</div>
	</div>
	<div class="row mb-3">
		<label for="editShohinCode" class="col-sm-3 col-form-label">商品コード</label>
		<div class="col-sm-5">
			<InputSelect id="editShohinCode" @bind-Value="EditShohinCode" class="form-control">
				<option value="">-- 選択してください --</option>
				@foreach (var shohin in ShohinMasterList!)
				{
					<option value="@shohin.ShohinCode">@shohin.ShohinCode</option>
				}
			</InputSelect>
		</div>
	</div>
	<div class="d-flex gap-2">
		<button type="button" class="btn btn-warning" @onclick='() => SearchForEdit(EditShiireDate, EditShohinCode)'>修正画面へ</button>
		<button type="button" class="btn btn-secondary" @onclick="ResetEditForm">リセット</button>
	</div>
</div>
<hr class="mt-4" />

<div class="card p-4 mb-4">
	<h2>仕入削除</h2>

	<div class="row mb-3">
		<div class="row mb-3">
			<label for="deleteDate" class="col-sm-3 col-form-label">仕入日付(YYYY-MM-DD)</label>
			<div class="col-sm-5">
				<input id="deleteDate" type="date" class="form-control" @bind="DeleteShiireDate" />
			</div>
		</div>
		<div class="row mb-3">
			<label for="deleteShohinCode" class="col-sm-3 col-form-label">商品コード</label>
			<div class="col-sm-5">
				<InputSelect id="deleteShohinCode" @bind-Value="DeleteShohinCode" class="form-control">
					<option value="">-- 選択してください --</option>
					@foreach (var shohin in ShohinMasterList!)
					{
						<option value="@shohin.ShohinCode">@shohin.ShohinCode : @shohin.ShohinMeiKanji</option>
					}
				</InputSelect>
			</div>
		</div>
		<div class="d-flex gap-2">
			<button type="button" class="btn btn-warning" @onclick='() => SearchForDelete(DeleteShiireDate, DeleteShohinCode)'>削除画面へ</button>
			<button type="button" class="btn btn-secondary" @onclick="ResetDeleteForm">リセット</button>
		</div>
	</div>
</div>

<button class="btn btn-secondary w-100" @onclick="GoBack">ホームメニューに戻る</button>

@code {
	// メッセージ
	private string? Message { get; set; }
	private bool IsError { get; set; }

	// 検索用
	private string SearchYearMonthString { get; set; } = string.Empty;
	private string SearchShohinCode { get; set; } = string.Empty;
	private List<ShohinModel> ShohinMasterList { get; set; } = new();

	// 登録用
	private List<ShiiresakiModel> ShiiresakiMasterList { get; set; } = new();
	private ShiireModel NewShiireModel { get; set; } = new();
	private string? RegisterErrorMessage { get; set; }

	// 修正用
	private string? EditShiireDate { get; set; }
	private string EditShohinCode { get; set; } = string.Empty;

	// 削除用
	private string? DeleteShiireDate { get; set; }
	private string DeleteShohinCode { get; set; } = string.Empty;

	/// <summary>
	/// 初期化表示の前に一回だけ呼び出される
	/// </summary>
	protected override async Task OnInitializedAsync()
	{
		await LoadShohinMasterAsync();
		await LoadShiiresakiMasterAsync();
	}

	/// <summary>
	/// 商品マスターデータを取得する
	/// </summary>
	/// <returns>ヒットした全商品データ</returns>
	private async Task LoadShohinMasterAsync()
	{
		try
		{
			if (ShohinRepo != null)
			{
				ShohinMasterList = await ShohinRepo.GetAllAsync();
			}
		}
		catch (Exception ex)
		{
			Message = $"商品マスタのロード中にエラーが発生しました: {ex.Message}";
			IsError = true;
			ShohinMasterList = new List<ShohinModel>();
			StateHasChanged();
		}
	}

	/// <summary>
	/// 仕入先マスターデータを取得する
	/// </summary>
	/// <returns></returns>
	private async Task LoadShiiresakiMasterAsync()
	{
		try
		{
			if (ShiiresakiRepo != null)
			{
				ShiiresakiMasterList = await ShiiresakiRepo.GetAllAsync();
			}
		}
		catch (Exception ex)
		{
			Message = $"仕入先マスタのロード中にエラーが発生しました: {ex.Message}";
			IsError = true;
			ShohinMasterList = new List<ShohinModel>();
			StateHasChanged();
		}
	}

	/// <summary>
	/// 検索処理
	/// </summary>
	/// <param name="actionType"></param>
	/// <returns>URI</returns>
	private async Task SearchAndNavigate(string actionType)
	{
		Message = null;
		IsError = false;

		try
		{
			if (string.IsNullOrWhiteSpace(SearchYearMonthString) || string.IsNullOrEmpty(SearchShohinCode))
			{
				Message = "入力項目が不足しています";
				IsError = true;
				StateHasChanged();
				return;
			}

			if (!DateTime.TryParse(SearchYearMonthString + "-01", out var ym))
			{
				Message = "仕入年月形式が正しくありません (YYYY-MM形式で入力してください)";
				IsError = true;
				StateHasChanged();
				return;
			}

			// 月単位検索
			var results = await ShiireRepository.SearchByMonthAsync(ym.Year, ym.Month, SearchShohinCode);

			if (results == null || results.Count == 0)
			{
				Message = "該当する仕入はありませんでした";
				StateHasChanged();
				return;
			}

			ShiireService.SetSearchResults(results);
			NavManager.NavigateTo("/shiire/search");
		}
		catch (Exception ex)
		{
			Message = $"エラーが発生しました: {ex.Message}";
		}
	}

	/// <summary>
	/// 検索フォーム
	/// </summary>
	private void ResetSearchForm()
	{
		SearchYearMonthString = string.Empty;
		SearchShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// 新規仕入登録
	/// </summary>
	/// <returns></returns>
	private async Task NewShiireRegistrationAsync()
	{
		RegisterErrorMessage = null;

		try
		{
			if (string.IsNullOrWhiteSpace(NewShiireModel.ShiireBi))
			{
				RegisterErrorMessage = "仕入日付を入力してください。";
				return;
			}
			if (string.IsNullOrWhiteSpace(NewShiireModel.ShohinCode))
			{
				RegisterErrorMessage = "商品コードを選択してください。";
				return;
			}
			if (string.IsNullOrWhiteSpace(NewShiireModel.ShiiresakiCode))
			{
				RegisterErrorMessage = "仕入先コードを選択してください。";
				return;
			}
			if (NewShiireModel.Quantity == null || NewShiireModel.Quantity <= 0)
			{
				RegisterErrorMessage = "数量は1以上を入力してください。";
				return;
			}

			var affectedRows = await ShiireRepository.RegisterAsync(NewShiireModel);

			if (affectedRows > 0)
			{
				ShiireService.SetLastRegisteredShiire(NewShiireModel);
				NavManager.NavigateTo("/shiire/register");
				ResetNewForm();
			}
			else
			{
				RegisterErrorMessage = "登録処理が正常に完了しませんでした。影響を受けた行数が0です";
			}
		}
		catch (Exception ex)
		{
			RegisterErrorMessage = $"登録中にシステムエラーが発生しました: {ex.Message}";
		}
	}

	/// <summary>
	/// 登録フォームリセットメソッド
	/// </summary>
	private void ResetNewForm()
	{
		NewShiireModel = new ShiireModel();
		RegisterErrorMessage = null;
	}

	/// <summary>
	/// 仕入修正検索
	/// </summary>
	/// <param name="date">入力された仕入日付</param>
	/// <param name="shohinCode">入力された商品コード</param>
	/// <returns></returns>
	private async Task SearchForEdit(string? date, string? shohinCode)
	{
		Message = null;
		IsError = false;

		if (string.IsNullOrEmpty(date) || string.IsNullOrEmpty(shohinCode))
		{
			Message = "入力項目が不足しています";
			IsError = true;
			StateHasChanged();
			return;
		}

	var results = await ShiireRepository.SearchByDateAsync(date.Value, shohinCode);

		try
		{
			NavManager.NavigateTo($"/shiire/edit/{date}/{shohincode}");
		}

		if (results == null || results.Count == 0)
		{
			Message = "該当する仕入はありませんでした";
			return;
		}

		ShiireService.SetLastEditResult(NewShiireModel);
		NavManager.NavigateTo("/shiire/edit/select");
		ResetEditForm();
	}

	/// <summary>
	/// 修正フォームリセット
	/// </summary>
	private void ResetEditForm()
	{
		EditShiireDate = null;
		EditShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// 仕入れ削除機能
	/// </summary>
	/// <param name="date">入力された仕入日付</param>
	/// <param name="shohinCode">商品コード</param>
	/// <returns></returns>
	private async Task SearchForDelete(DateTime? date, string shohinCode)
	{
		if (date == null || string.IsNullOrWhiteSpace(shohinCode))
		{
			Message = "入力項目が不足しています";
			IsError = true;
			return;
		}

		var results = await ShiireRepository.SearchByDateAsync(date.Value, shohinCode);

		if (results == null || results.Count == 0)
		{
			Message = "該当する仕入はありませんでした";
			return;
		}

		ShiireService.SetLastDeleteResult(NewShiireModel);
		NavManager.NavigateTo("/shiire/delete/select");
		ResetDeleteForm();
	}

	/// <summary>
	/// 削除フォームリセット
	/// </summary>
	private void ResetDeleteForm()
	{
		DeleteShiireDate = null;
		DeleteShohinCode = string.Empty;
		Message = null;
		IsError = false;
	}

	/// <summary>
	/// メインメニューに戻る
	/// </summary>
	private void GoBack()
	{
		NavManager.NavigateTo("/");
	}
}

